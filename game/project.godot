; Engine configuration file.
config_version=5

[application]
config/name="SIS"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://src/app/main.tscn"
config/icon="res://data/icon.png"
config/quit_on_go_back=false

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[input_devices]
pointing/emulate_touch_from_mouse=true

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[autoload]

Profile="*res://src/core/profile.gd"
Analytics="*res://src/services/analytics.gd"
Platform="*res://src/services/platform.gd"
Music="*res://src/audio/music.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/sis_platform/plugin.cfg")
